# 服务配置
NAME=base-server
ENV=release
HOST=0.0.0.0
PORT=8080

# Docker 服务与 Alloy 在同一个 net 网络时使用该地址
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy:4318/v1/traces

# PostgreSQL 配置可选；需要数据库时取消注释并填写完整配置
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=base_server
# DB_USERNAME=postgres
# DB_PASSWORD=change-me
# DB_SSL_MODE=require
