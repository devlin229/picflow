# 服务配置
NAME=picflow
ENV=debug
HOST=0.0.0.0
PORT=8080

# SQLite、原图和处理结果统一保存在该目录
DATA_DIR=./data

# 统一镜像中由后端托管的前端构建目录；本地前后端分开开发时保持为空
WEB_DIR=

# 单张图片最大体积，单位 MB
MAX_UPLOAD_SIZE_MB=20

# 同时执行图片处理任务的 Worker 数量
WORKER_COUNT=2

# 跨域部署时填写允许的前端来源，多个来源使用英文逗号分隔；同源部署保持为空
CORS_ALLOWED_ORIGINS=

# Grafana Tempo OTLP/HTTP 地址，可按需取消注释
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
