# 服务配置
NAME=picflow
ENV=debug
HOST=0.0.0.0
PORT=8080

# SQLite、原图和处理结果统一保存在该目录
DATA_DIR=./data

# 统一镜像中由后端托管的前端构建目录；本地前后端分开开发时保持为空
WEB_DIR=

# 单张图片最大体积，单位 MB
MAX_UPLOAD_SIZE_MB=20

# 同时执行图片处理任务的 Worker 数量
WORKER_COUNT=2

# AI 图片编辑；密钥留空时禁用，仅在选择 AI 换背景时调用
# OpenAI：协议改为 openai，地址改为 https://api.openai.com/v1，模型改为 gpt-image-2.5-sunburst
# 基础地址和模型留空时按协议选用默认值；切换供应商时必须同时切换密钥
LLM_PROTOCOL=qwen
LLM_API_KEY=
LLM_BASE_URL=https://maas.qianwenaiapi.com/api/v1
LLM_MODEL=qwen-image-3.0
LLM_TIMEOUT_SECONDS=600
LLM_REQUESTS_PER_MINUTE=20

# 跨域部署时填写允许的前端来源，多个来源使用英文逗号分隔；同源部署保持为空
CORS_ALLOWED_ORIGINS=

# Grafana Tempo OTLP/HTTP 地址，可按需取消注释
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
